{
  "name": "agentbd",
  "version": "0.1.0",
  "description": "多 agent 统一总线（ACP 为中心）：把 Claude/Codex/Gemini/WorkBuddy/Qoder 等收敛成一套统一事件流",
  "type": "module",
  "private": true,
  "bin": {
    "agentbd": "src/cli.ts"
  },
  "scripts": {
    "engines": "node src/cli.ts engines",
    "doctor": "node src/cli.ts doctor",
    "ask": "node src/cli.ts ask",
    "sessions": "node src/cli.ts sessions",
    "services": "node src/cli.ts services",
    "mcp": "node src/cli.ts mcp",
    "serve": "node src/cli.ts serve",
    "ui-verify": "node scripts/ui-verify.mjs",
    "lamp-test": "bash shell/lamp-test.sh",
    "failover-test": "node --import tsx scripts/failover-test.mjs",
    "models-test": "node scripts/models-test.mjs",
    "ui-undecl-test": "node scripts/ui-undecl-test.mjs",
    "test": "npm run typecheck && npm run init-test && npm run guard-test && npm run models-test && npm run ui-undecl-test && npm run failover-test",
    "typecheck": "tsc --noEmit",
    "init-test": "node scripts/init-test.mjs",
    "guard-test": "node scripts/guard-test.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.0",
    "@agentclientprotocol/codex-acp": "^1.13.0",
    "@agentclientprotocol/sdk": "^1.5.0",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^27.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
